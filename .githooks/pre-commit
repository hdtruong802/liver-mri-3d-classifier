#!/usr/bin/env sh
# Quality gate chung cho mọi tool AI coding dùng trên repo này.
#
# Kích hoạt một lần (hook được commit nên áp cho mọi tool, kể cả Antigravity):
#   git config core.hooksPath .githooks
#
# Bỏ qua có chủ đích:  git commit --no-verify   (phải ghi lý do vào WORKLOG.md)

exec sh "$(git rev-parse --show-toplevel)/scripts/quality-gate.sh" --staged
