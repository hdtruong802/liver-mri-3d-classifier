{
  // `composite` là BẮT BUỘC vì `tsconfig.json` tham chiếu file này qua `references`.
  // Thiếu nó, `tsc -b` không biết project này sinh ra gì nên nó đoán là `src/App.js`
  // đặt cạnh mã nguồn; mà `noEmit: true` khiến file đó không bao giờ tồn tại, nên
  // project VĨNH VIỄN bị coi là out of date và `npm run build` typecheck lại từ đầu
  // mọi lần. TypeScript 5.9 không báo lỗi chuyện này — nó im lặng xuống thang thành
  // "luôn build lại", `tsc` vẫn exit 0 nên không có gì lộ ra.
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    // Không khai `baseUrl`: nó bị deprecate ở TS 6.0, và từ TS 4.4 `paths` đã tự
    // giải theo vị trí của chính file tsconfig này. Đường dẫn dưới đây vốn đã tương
    // đối nên bỏ `baseUrl` không đổi hành vi, chỉ hết cảnh báo. Không dùng
    // `ignoreDeprecations` để tắt tiếng — TS 5.9 chỉ nhận giá trị "5.0", khai "6.0"
    // làm cả typecheck đỏ (TS5103).
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
